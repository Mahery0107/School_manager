# Modèle de backend/.env pour le serveur (VPS). Copier en backend/.env puis compléter les valeurs <...>.
# Après toute modification de ce fichier : php artisan config:cache

APP_NAME="Gestion École"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<votre-domaine>
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_ECOLE="Collège FIANARAN-TSOA Ambohimiandra"
JOUR_LIMITE_ECOLAGE=10

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_manager
DB_USERNAME=ecole
DB_PASSWORD=<mot-de-passe-mysql-long-et-aleatoire>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Session de connexion : 12 h
SANCTUM_EXPIRATION=720

# Sauvegarde automatique chaque soir, conservée 30 jours
MYSQLDUMP_PATH=mysqldump
SAUVEGARDE_HEURE=23:30
SAUVEGARDE_JOURS=30
